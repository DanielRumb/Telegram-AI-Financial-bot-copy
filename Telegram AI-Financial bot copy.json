      "parameters": {
        "jsCode": "const chatId = $('Loop Over Items').item.json.chat_id;\nconst allExpenses = $input.all().map(item => item.json);\n\nconst yesterday = new Date();\nyesterday.setDate(yesterday.getDate() - 1);\nconst yesterdayStr = yesterday.toISOString().split('T')[0];\n\nconst yesterdayExpenses = allExpenses.filter(e => {\n  const expDate = new Date(e.date).toISOString().split('T')[0];\n  return expDate === yesterdayStr;\n});\n\nconst total = yesterdayExpenses.reduce((sum, e) => sum + Number(e.amount || 0), 0);\nconst lines = yesterdayExpenses.map(e => `• ${e.category}: ${e.amount} руб.`).join('\\n');\n\nreturn {\n  json: {\n    chat_id: chatId,\n    total,\n    lines: lines || 'Вчера трат не было'\n  }\n};"
